# ==============================================================================
# SnipClip — Sanitized Local Environment Template (.env.example)
# ==============================================================================
# ZERO SECRETS REQUIRED:
# SnipClip requires ZERO API keys, database URLs, or third-party credentials to
# build, test, package, or run locally. Both the native C11/GTK 3 Linux desktop
# binary (`native/build/snipclip` -> `/usr/bin/snipclip`) and the React 19 +
# Vite Web Workbench (`npm run dev`) execute 100% offline/locally.
#
# NOTE ON LEGACY PLACEHOLDER:
# An earlier Google AI Studio scaffold left an unused `GEMINI_API_KEY=` stub in
# this file. SnipClip makes zero Gemini or external HTTP API calls anywhere in
# the codebase, so that placeholder has been removed.
#
# SECURITY WARNING (.gitignore):
# `.gitignore` currently does NOT ignore `.env` or `.env.*` files yet (tracked
# in `todo.md`). Do NOT store real tokens, passwords, or private keys in `.env`
# until `.env*` ignore rules are added to `.gitignore`.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Web Workbench / Vite Dev Server (`vite.config.ts`)
# ------------------------------------------------------------------------------

# Controls Vite WebSocket Hot Module Replacement (`vite.config.ts:17`).
# Expected format: `"true"` | `"false"` (checked via `process.env.DISABLE_HMR !== 'true'`).
# Local default: keep `false` (or unset) for live HMR on `http://localhost:3000`.
# Set to `true` ONLY inside proxied cloud IDE sandboxes that block WebSocket upgrades.
DISABLE_HMR=false


# ------------------------------------------------------------------------------
# 2. Native C11 Build & Debian `.deb` Packaging Overrides
#    (`native/Makefile`, `scripts/build-deb.sh`)
# ------------------------------------------------------------------------------
# Passed via shell environment when invoking `make -C native` or `npm run build:deb`
# (`bash scripts/build-deb.sh`). Leave commented out for standard local builds.

# C11 compiler binary (`native/Makefile:1`, assigned via `CC ?= gcc`).
# Expected format: executable name or path (e.g., `gcc`, `clang`).
# CC=gcc

# pkg-config binary used to resolve `gtk+-3.0`, `gio-2.0`, and `x11` flags
# (`native/Makefile:2`, assigned via `PKG_CONFIG ?= pkg-config`).
# Expected format: executable name or path.
# PKG_CONFIG=pkg-config

# Target Debian package architecture override (`scripts/build-deb.sh:23`).
# Expected format: Debian arch string (e.g., `amd64`, `arm64`).
# Local default when unset: auto-detected via `dpkg --print-architecture` (fallback `amd64`).
# DEB_ARCH=amd64

# GitHub Actions release tag fallback (`scripts/build-deb.sh:7`).
# Used ONLY when CLI argument `$1` is omitted; must match `^v?[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$`
# (e.g., `v2.1.0`). Warning: `scripts/build-deb.sh:34` syncs the resolved version into
# `VERSION` and `native/include/snipclip_version.h`. Leave unset locally so `VERSION` is used.
# GITHUB_REF_NAME=


# ------------------------------------------------------------------------------
# 3. Native Linux Runtime Display & Session Variables (Reference Only)
#    (Auto-detected by `/usr/bin/snipclip` in `native/src/display_detect.c`)
# ------------------------------------------------------------------------------
# Provided automatically by your Linux login/desktop session (GNOME, KDE Plasma,
# XFCE, Cinnamon, Sway, Hyprland, and other X11/Wayland compositors). Do NOT uncomment in `.env` for normal
# usage; override inline on the command line ONLY when testing
# `./native/build/snipclip --detect-display`, running headless tests under
# `Xvfb` (e.g., `DISPLAY=:99`), or debugging custom Wayland/X11 compositors.
# Note: `native/src/display_detect.c:46` also reads standard system `PATH`
# (fallback `/usr/local/bin:/usr/bin:/bin`) to probe optional capture/clipboard
# helpers (`loginctl`, `gdbus`, `grim`, `spectacle`, `gnome-screenshot`, `wl-copy`, `xclip`, `xsel`).

# Highest-priority session protocol hint (`native/src/display_detect.c:263,365`).
# Expected format: `wayland` | `x11` (case-insensitive).
# XDG_SESSION_TYPE=

# Wayland compositor socket filename inside `XDG_RUNTIME_DIR` (`native/src/display_detect.c:270,369,395`).
# Expected format: socket name such as `wayland-0` (auto-discovered if unset).
# WAYLAND_DISPLAY=

# X11 / XWayland server display string (`native/src/display_detect.c:271,409`).
# Expected format: `:<display_number>` (e.g., `:0`, or `:99` for `Xvfb`; auto-discovered from `/tmp/.X11-unix` if unset).
# DISPLAY=

# Per-user runtime directory scanned for `wayland-*` UNIX sockets (`native/src/display_detect.c:352,399`).
# Expected format: absolute directory path (defaults to `/run/user/<uid>` if unset).
# XDG_RUNTIME_DIR=

# Primary desktop environment name displayed in diagnostics (`native/src/display_detect.c:273`).
# Expected format: freedesktop string (e.g., `KDE`, `ubuntu:GNOME`, `XFCE`, `sway`).
# XDG_CURRENT_DESKTOP=

# Fallback desktop session identifier read when `XDG_CURRENT_DESKTOP` is unset (`native/src/display_detect.c:274`).
# Expected format: session name (e.g., `plasma`, `ubuntu`, `xfce`; defaults to `Generic Linux Desktop`).
# DESKTOP_SESSION=

# systemd-logind session ID queried via `loginctl show-session <id> -p Type --value`
# when `XDG_SESSION_TYPE` and `WAYLAND_DISPLAY` are unset (`native/src/display_detect.c:151`).
# Expected format: alphanumeric / `-` / `_` token (e.g., `2`, `c1`).
# XDG_SESSION_ID=

# GTK 3 / GDK display backend selector (`native/src/display_detect.c:390-392`).
# Expected format: `wayland,x11` | `x11` | `broadway`.
# Local default when unset: `sc_bootstrap_display_env()` sets `wayland,x11` on Wayland or `x11` on X11.
# GDK_BACKEND=
