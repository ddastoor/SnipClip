[Desktop Entry]
Type=Application
Name=SnipClip
GenericName=Screenshot & Snipping Tool
Comment=Capture and annotate rectangular, window, fullscreen, and freeform snips on X11 and Wayland
Exec=/usr/bin/snipclip
Icon=snipclip
Terminal=false
Categories=Utility;Graphics;2DGraphics;
Keywords=screenshot;snip;snipping;capture;crop;annotate;x11;wayland;
StartupNotify=true
Actions=RectSnip;WindowSnip;FullSnip;

[Desktop Action RectSnip]
Name=New Rectangular Snip
Exec=/usr/bin/snipclip --mode rectangle --capture-now

[Desktop Action WindowSnip]
Name=New Window Snip
Exec=/usr/bin/snipclip --mode window --capture-now

[Desktop Action FullSnip]
Name=New Fullscreen Snip
Exec=/usr/bin/snipclip --mode fullscreen --capture-now
